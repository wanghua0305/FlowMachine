<UserControl x:Class="FlowMachine.App.Views.StationWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FlowMachine.App.ViewModels"
             xmlns:nodify="https://miroiu.github.io/nodify"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <vm:InverseBooleanConverter x:Key="InverseBooleanConverter" />

        <Style x:Key="StationNodeStyle" TargetType="{x:Type nodify:ItemContainer}">
            <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
        </Style>

        <DataTemplate x:Key="StationNodeTemplate" DataType="{x:Type vm:EditorNodeViewModel}">
            <Border x:Name="NodeBorder"
                    MinWidth="190"
                    Padding="8"
                    CornerRadius="6"
                    BorderBrush="#64748B"
                    BorderThickness="2"
                    Background="#202B3A">
                <StackPanel>
                    <nodify:Connector DataContext="{Binding Input}"
                                      Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                      IsConnected="{Binding IsConnected}"
                                      HorizontalAlignment="Left"
                                      Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <DockPanel Margin="3,4">
                        <TextBlock Text="{Binding Title}"
                                   FontWeight="Bold"
                                   Foreground="White" />
                        <TextBlock Text="{Binding Status}"
                                   DockPanel.Dock="Right"
                                   Margin="10,0,0,0"
                                   Foreground="#A5B4FC" />
                    </DockPanel>
                    <TextBlock Text="{Binding Configuration.Message}"
                               Foreground="#CBD5E1"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="210" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">
                        <TextBlock Text="Next"
                                   VerticalAlignment="Center"
                                   Foreground="#94A3B8"
                                   Margin="0,0,3,0"
                                   Visibility="{Binding OutputNextVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <nodify:Connector DataContext="{Binding OutputNext}"
                                          Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                          IsConnected="{Binding IsConnected}"
                                          Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="True"
                                   VerticalAlignment="Center"
                                   Foreground="#86EFAC"
                                   Margin="6,0,3,0"
                                   Visibility="{Binding OutputTrueVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <nodify:Connector DataContext="{Binding OutputTrue}"
                                          Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                          IsConnected="{Binding IsConnected}"
                                          Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="False"
                                   VerticalAlignment="Center"
                                   Foreground="#FCA5A5"
                                   Margin="6,0,3,0"
                                   Visibility="{Binding OutputFalseVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <nodify:Connector DataContext="{Binding OutputFalse}"
                                          Anchor="{Binding Anchor, Mode=OneWayToSource}"
                                          IsConnected="{Binding IsConnected}"
                                          Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Running">
                    <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#FBBF24" />
                    <Setter TargetName="NodeBorder" Property="Background" Value="#3B3523" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Succeeded">
                    <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#22C55E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="NodeBorder" Property="BorderBrush" Value="#EF4444" />
                    <Setter TargetName="NodeBorder" Property="Background" Value="#3B252A" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="StationConnectionTemplate" DataType="{x:Type vm:EditorConnectionViewModel}">
            <nodify:StepConnection Source="{Binding Source.Anchor}"
                                   Target="{Binding Target.Anchor}"
                                   Stroke="#64748B"
                                   StrokeThickness="2" />
        </DataTemplate>

        <DataTemplate x:Key="PendingConnectionTemplate" DataType="{x:Type vm:PendingConnectionViewModel}">
            <nodify:PendingConnection IsVisible="{Binding IsVisible}"
                                      Source="{Binding Source, Mode=OneWayToSource}"
                                      Target="{Binding Target, Mode=OneWayToSource}"
                                      TargetAnchor="{Binding TargetLocation, Mode=OneWayToSource}"
                                      StartedCommand="{Binding DataContext.StartConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      CompletedCommand="{Binding DataContext.CreateConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type nodify:NodifyEditor}}}"
                                      AllowOnlyConnectors="True" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="8" Margin="0,0,0,8" CornerRadius="5"
                Background="#F8FAFC">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Start Flow" Command="{Binding StartCommand}" Margin="2" Padding="12,5" />
                    <Button Content="Stop" Command="{Binding StopCommand}" Margin="2" Padding="12,5" />
                    <Button Content="Pause" Command="{Binding PauseCommand}" Margin="2" Padding="12,5" />
                    <Button Content="Resume" Command="{Binding ResumeCommand}" Margin="2" Padding="12,5" />
                    <Button Content="Reset" Command="{Binding ResetCommand}" Margin="2" Padding="12,5" />
                    <Button Content="Home" Command="{Binding HomeCommand}" Margin="12,2,2,2" Padding="12,5" />
                    <Button Content="Run selected TestStation" Command="{Binding RunTestCommand}"
                            Margin="12,2,2,2" Padding="12,5" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="BUS" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0" />
                    <TextBlock Text="{Binding BusStateText}" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Save" Command="{Binding SaveCommand}" Margin="2" Padding="12,5" />
                    <Button Content="Load" Command="{Binding LoadCommand}" Margin="2" Padding="12,5" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="0,0,8,0" Padding="8" CornerRadius="5"
                    Background="#F8FAFC">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Stations" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
                        <WrapPanel Margin="0,0,0,6">
                            <Button Content="+ Flow" Command="{Binding AddStationCommand}" CommandParameter="flow" Margin="1" />
                            <Button Content="+ Home" Command="{Binding AddStationCommand}" CommandParameter="home" Margin="1" />
                            <Button Content="+ Test" Command="{Binding AddStationCommand}" CommandParameter="test" Margin="1" />
                        </WrapPanel>
                        <Button Content="Delete selected station" Command="{Binding RemoveStationCommand}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                    </StackPanel>
                    <DataGrid ItemsSource="{Binding Stations}"
                              SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="{Binding IsBusy}"
                              HeadersVisibility="Column"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Station" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeName}" IsReadOnly="True" Width="58" />
                            <DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled}" Width="38" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="0,0,8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,5">
                    <TextBlock Text="Node toolbox — drag an item onto the canvas"
                               FontWeight="Bold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <Button Content="+" Command="{x:Static nodify:EditorCommands.ZoomIn}"
                                CommandTarget="{Binding ElementName=FlowEditor}" />
                        <Button Content="−" Command="{x:Static nodify:EditorCommands.ZoomOut}"
                                CommandTarget="{Binding ElementName=FlowEditor}" />
                        <Button Content="Fit" Command="{x:Static nodify:EditorCommands.FitToScreen}"
                                CommandTarget="{Binding ElementName=FlowEditor}" />
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1">
                    <nodify:NodifyEditor x:Name="FlowEditor"
                                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                         ItemsSource="{Binding SelectedStation.Nodes}"
                                         Connections="{Binding SelectedStation.Connections}"
                                         SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                         PendingConnection="{Binding PendingConnection}"
                                         PendingConnectionTemplate="{StaticResource PendingConnectionTemplate}"
                                         ConnectionTemplate="{StaticResource StationConnectionTemplate}"
                                         ItemTemplate="{StaticResource StationNodeTemplate}"
                                         ItemContainerStyle="{StaticResource StationNodeStyle}"
                                         DisconnectConnectorCommand="{Binding DisconnectConnectorCommand}"
                                         AllowDrop="True"
                                         Drop="OnEditorDrop"
                                         Background="#131B27" />
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                            Background="#CC202B3A" Padding="6">
                        <ListBox x:Name="ToolboxList" BorderThickness="0"
                                 Background="Transparent"
                                 PreviewMouseMove="OnToolboxMouseMove">
                            <ListBoxItem Content="Start" Tag="start" />
                            <ListBoxItem Content="End" Tag="end" />
                            <ListBoxItem Content="Delay" Tag="delay" />
                            <ListBoxItem Content="Log" Tag="log" />
                            <ListBoxItem Content="Condition" Tag="condition" />
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Column="2" Padding="10" CornerRadius="5"
                    Background="#F8FAFC">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected node" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding SelectedNode.Title}" FontWeight="Bold" />
                        <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNode.Type}" Value="delay">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Delay (milliseconds)" />
                                <TextBox Text="{Binding SelectedNode.DelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Timeout (0 = disabled)" Margin="0,5,0,0" />
                                <TextBox Text="{Binding SelectedNode.TimeoutMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNode.Type}" Value="log">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Log message" />
                                <TextBox Text="{Binding SelectedNode.Message, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" Height="70" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedNode.Type}" Value="condition">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="Simulated condition key" />
                                <TextBox Text="{Binding SelectedNode.ConditionKey, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Content="Condition result is True"
                                          IsChecked="{Binding SelectedNode.ConditionValue}" />
                                <TextBlock Text="Connect both True and False outputs."
                                           TextWrapping="Wrap" Foreground="#64748B" />
                            </StackPanel>
                            <Button Content="Delete selected node"
                                    Command="{Binding DeleteNodeCommand}" Margin="0,12,0,0" />
                        </StackPanel>

                        <TextBlock Text="Connections" FontSize="16" FontWeight="Bold" Margin="0,18,0,5" />
                        <ItemsControl ItemsSource="{Binding SelectedStation.Connections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3">
                                        <Button Content="×" DockPanel.Dock="Right"
                                                Command="{Binding DataContext.RemoveConnectionCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                CommandParameter="{Binding}" />
                                        <TextBlock Text="{Binding Definition.Branch}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" CornerRadius="5"
                Background="#F8FAFC">
            <DockPanel>
                <TextBlock Text="Runtime log" DockPanel.Dock="Top"
                           FontSize="15" FontWeight="Bold" Margin="0,0,0,5" />
                <ListBox ItemsSource="{Binding Logs}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}" />
                                <Run Text="  " />
                                <Run Text="{Binding StationName}" FontWeight="Bold" />
                                <Run Text="  " />
                                <Run Text="{Binding Message}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Margin="3,6,3,0"
                   TextWrapping="Wrap" Foreground="#475569" />
    </Grid>
</UserControl>
